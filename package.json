{
  "name": "ring-comparison",
  "version": "1.0.0",
  "private": true,
  "description": "A transparent comparison ledger for South African ring quotes.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
